# Redis
REDIS_PASSWORD=your_redis_password

# Qdrant
QDRANT_API_KEY=your_qdrant_api_key

# DeepSeek
DEEPSEEK_WORKER_KEY=sk-your_deepseek_key

# Embedding (Qwen DashScope)
EMBEDDING_API_KEY=sk-your_qwen_key
EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMS=1024

# Optional: OpenRouter (fallback)
# OPENROUTER_API_KEY=sk-your_openrouter_key

# No proxy for internal services
no_proxy=qdrant,redis,localhost,127.0.0.1,dashscope.aliyuncs.com

